# manifest on metis — the canonical unit (repo artifact, not tribal state).
# Supersedes the hand-rolled 2026-08 unit. Install:
#   sudo cp deploy/manifest.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart manifest
#
# Write surface (owner decision 2026-08-11, with Phase 2 sync live): the metis
# dashboard is a full cockpit — phone-driven feed keep/discard, approvals
# confirm, spool run-now need writes to BOTH the harness tree and the vault
# (approvals apply → aion-approved capability). manifest-sync converges those
# writes across machines; the human-is-the-mutex rule still governs
# interactive editing (don't type on both dashboards in one sitting).
# /private is a manually-unlocked LUKS volume: ConditionPathExists keeps the
# unit dead after a reboot until the mount returns (full path-unit automation
# is Phase 3d).
[Unit]
Description=Manifest - local-first dashboard over Benjamin's Obsidian vault
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/private/consciousrepo/goals.md

[Service]
Type=simple
User=benjamin
Group=benjamin
WorkingDirectory=/home/benjamin/src/manifest
Environment=GOTOOLCHAIN=auto
# metis is UTC; the owner's clock is Chicago. Cron next-fire math and run
# stamps read the process TZ — without this every ritual display (and the
# engine's schedule, pinned the same way in ITS unit) shifts 5-6 hours.
Environment=TZ=America/Chicago
ExecStart=/home/benjamin/src/manifest/manifest -config /home/benjamin/src/manifest/config.json
Restart=on-failure
RestartSec=5

# Hardening — read-only everywhere except the write territories:
# dataDir (per-machine state), the vault clone, and the harness clone.
# The AION portal publish target is this same manifest checkout (2026-08-15:
# publish writes server/web/portal/, commits + pushes; autodeploy rebuilds) —
# covered by the /home/benjamin line below. ReadWritePaths takes precedence
# over ProtectHome.
NoNewPrivileges=true
# ⚠ PrivateTmp is OFF on purpose (2026-09-04). It gave the service a private
# tmpfs that systemd DELETES when the unit stops — and the terminal cockpit's
# tmux sessions, which now outlive a restart by design, kept that deleted
# directory as their /tmp. Every temp write in a surviving session then failed
# with ENOENT: Claude Code exited instantly on `mkdir '/tmp/claude-1001'`, and
# `go build` would have gone the same way. The sessions ARE the point of this
# unit's terminal surface, so /tmp is the real one. (The tool also exports a
# durable TMPDIR of its own — belt and braces, and it covers boxes whose unit
# still sets this.)
# PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/benjamin/.config/manifest
ReadWritePaths=/home/benjamin/.config/excalibur
# The terminal cockpit runs real PTY shells (and the FILES stage writes) as
# children of this unit — home must be writable for them to do real work.
ReadWritePaths=/home/benjamin
ReadWritePaths=/private/consciousrepo
ReadWritePaths=/private/harnesses
ReadWritePaths=/home/benjamin/re-portal
ReadWritePaths=/shared/apps/aion-portal
ReadWritePaths=/shared/apps

[Install]
WantedBy=multi-user.target
