# Guarded transcript polling creates pending approvals only.
# The dashboard owns approval decisions and vault writes.
[Unit]
Description=Manifest Granola and Pocket proposal worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/benjamin/.config/manifest/transcript-worker.json

[Service]
Type=simple
User=benjamin
Group=benjamin
ExecStart=/home/benjamin/.local/bin/manifest-transcript-worker -config /home/benjamin/.config/manifest/transcript-worker.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/benjamin/.config/manifest
ReadWritePaths=/private/harnesses/excalibur/vessel/state/dispatch-fence/ea-coordinator/granola-sync
ReadWritePaths=/private/harnesses/excalibur/vessel/state/dispatch-fence/ea-coordinator/pocket-sync
ReadOnlyPaths=/private/consciousrepo
ReadOnlyPaths=/private/harnesses/excalibur/artifacts
# Canonical proposal publication stages a temporary file in approvals/.
ReadWritePaths=/private/harnesses/excalibur/artifacts/approvals
ReadOnlyPaths=/private/harnesses/excalibur/artifacts/approvals/approved
ReadOnlyPaths=/private/harnesses/excalibur/artifacts/approvals/rejected

[Install]
WantedBy=multi-user.target
