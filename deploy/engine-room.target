# The engine room as one unit (big-change Phase 3d): everything that should
# run once /private is unlocked. Started by private-ready.path when the
# mount appears after a reboot + manual `private-unlock`; each member keeps
# its own ConditionPathExists guard as a belt to this suspender.
#   sudo cp deploy/engine-room.target deploy/private-ready.path /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable private-ready.path engine-room.target
[Unit]
Description=engine room - everything that runs once /private is unlocked
Wants=manifest.service manifest-sync.service excalibur-engine.service

[Install]
WantedBy=multi-user.target
