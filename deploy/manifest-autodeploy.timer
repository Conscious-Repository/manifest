# Every minute: is origin/main ahead of the box? (push = deploy — owner
# decision 2026-08-11; the tailnet dashboard is the live testing surface).
#   sudo cp deploy/manifest-autodeploy.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now manifest-autodeploy.timer
[Unit]
Description=manifest auto-deploy poll

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s

[Install]
WantedBy=timers.target
